# Copy to .env and fill in. NEVER commit .env.

# Any LiteLLM-style model string. Examples:
#   gemini/gemini-2.0-flash      (needs AGENTFORGE_API_KEY)
#   groq/llama-3.3-70b-versatile (needs AGENTFORGE_API_KEY)
#   ollama/llama3.1              (local; no key; set AGENTFORGE_BASE_URL)
AGENTFORGE_MODEL=gemini/gemini-2.0-flash
AGENTFORGE_API_KEY=
AGENTFORGE_BASE_URL=
AGENTFORGE_TEMPERATURE=0.2

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

RESEARCH_TIMEOUT_SECONDS=600
MAX_CONCURRENT_JOBS=2
